# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ===== OpenAI Configuration =====
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Application Limits =====
# Maximum characters for text input (cost control)
MAX_TEXT_LENGTH=20000

# Maximum PDF pages (cost control)
MAX_PDF_PAGES=10

# ===== Vector Store Configuration =====
# Directory for ChromaDB persistent storage
CHROMA_PERSIST_DIR=./src/data/chroma
CHROMA_COLLECTION=documents

# ===== Document Chunking =====
# Size of each text chunk in characters
CHUNK_SIZE=1000

# Overlap between chunks (preserves context)
CHUNK_OVERLAP=200

# ===== Backend Server Configuration =====
# Host to bind to (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
HOST=0.0.0.0

# Port for backend server
PORT=8000

# ===== CORS Configuration =====
# Comma-separated list of allowed frontend URLs
# Add your frontend URL here (default: Streamlit on port 8501)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ===== Logging =====
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Notes:
# - Never commit the .env file to version control (it contains secrets)
# - Use different values for development, staging, and production
# - Ensure .env is in .gitignore
